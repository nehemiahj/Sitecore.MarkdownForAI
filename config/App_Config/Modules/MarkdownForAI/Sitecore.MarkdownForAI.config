<?xml version="1.0" encoding="utf-8"?>
<!--
  Sitecore.MarkdownForAI (Sitecore 10.1 to 10.5, rule-based configuration).
  Serves Markdown versions of MVC and WebForms pages (/page.md, ?format=md) and /llms.txt.

  Do not edit this file: upgrades replace it. Put your settings (sites, excluded placeholders,
  default mode, field mappings) in App_Config/Include/MarkdownForAI/z.MarkdownForAI.Site.config;
  the package ships it as z.MarkdownForAI.Site.config.example.

  Roles: runs on Standalone and ContentDelivery. To also answer on ContentManagement (e.g. for
  testing), add "or ContentManagement" to every role:require below.
  The module's items (templates, option items, Ask AI) come from the Sitecore package or from
  Sitecore CLI serialization (serialization/MarkdownForAI.module.json), not from this file.
  Sitecore 8.0 to 10.0: use the Sitecore.MarkdownForAI.Legacy repository instead.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/">
  <sitecore>
    <settings>
      <!-- Master switch. -->
      <setting name="MarkdownForAI.Enabled" value="true" />

      <!-- Convert pages with WebForms (.aspx) layouts too. false = /page.md returns 404 for them. -->
      <setting name="MarkdownForAI.WebForms.Enabled" value="true" />

      <!-- Sites that answer Markdown requests, pipe separated. "*" = every site except Sitecore system sites. -->
      <setting name="MarkdownForAI.Sites" value="website" />

      <!-- /about-us.md serves the Markdown of /about-us; /index.md serves the home page. -->
      <setting name="MarkdownForAI.Extension" value=".md" />

      <!-- /about-us?format=md also works. Empty QueryStringKey disables it. -->
      <setting name="MarkdownForAI.QueryStringKey" value="format" />
      <setting name="MarkdownForAI.QueryStringValue" value="md" />

      <!-- Serve Markdown for "Accept: text/markdown" on the normal URL. Off by default because CDNs
           and shared caches must then vary on Accept. -->
      <setting name="MarkdownForAI.AcceptHeader" value="false" />

      <!-- Requests starting with these paths are never treated as Markdown requests. -->
      <setting name="MarkdownForAI.ExcludedPathPrefixes" value="/sitecore/|/-/|/api/|/layouts/|/App_Config/|/_DEV/|/temp/" />

      <!-- ===== Component controls (most specific wins) =====
           1. ExcludedPlaceholders: renderings in these placeholders, at any depth, are dropped.
              Dynamic placeholder suffixes (key-{GUID}-0, key_{GUID}) are matched.
           2. "md" rendering parameter on the placement: include | exclude.
           3. "md" in the rendering definition item's Parameters field (e.g. md=exclude): the component default.
           4. ExcludedRenderings / IncludedRenderings: rendering definition IDs, pipe separated.
           5. DefaultMode: include | exclude.
           The page layout itself is never rendered; only its placeholders are. -->
      <setting name="MarkdownForAI.ExcludedPlaceholders" value="header|footer|navigation|nav|breadcrumb" />
      <setting name="MarkdownForAI.ParameterName" value="md" />
      <setting name="MarkdownForAI.ExcludedRenderings" value="" />
      <setting name="MarkdownForAI.IncludedRenderings" value="" />
      <setting name="MarkdownForAI.DefaultMode" value="include" />

      <!-- Top-level placeholders to render, in order. Empty = every top-level placeholder used on the page. -->
      <setting name="MarkdownForAI.Placeholders" value="" />

      <!-- ===== HTML to Markdown conversion =====
           Elements with the data-md-ignore attribute, hidden, aria-hidden="true" or display:none are always removed. -->
      <setting name="MarkdownForAI.SkipTags" value="script|style|noscript|template|iframe|svg|canvas|form|button|input|select|textarea|object|embed|video|audio|head|meta|link|title|nav|map|dialog" />
      <setting name="MarkdownForAI.IgnoreClasses" value="" />
      <setting name="MarkdownForAI.IncludeImages" value="true" />

      <!-- ===== Front matter ===== first non-empty field wins; falls back to the item display name. -->
      <setting name="MarkdownForAI.TitleFields" value="LlmsTitle|Title|Page Title|Heading" />
      <setting name="MarkdownForAI.DescriptionFields" value="LlmsSummary|Meta Description|MetaDescription|Description|Summary|Abstract" />
      <!-- Front matter lines to write, pipe separated: title|description|url|language|last_updated.
           Remove any you do not want, or set "none" for no front matter. A title of "*" (a wildcard item)
           is always left out. Field mapping "meta" fields are written as configured. -->
      <setting name="MarkdownForAI.FrontMatterFields" value="title|description|url|language|last_updated" />

      <!-- ===== Caching =====
           Building Markdown renders the page and converts it, so the finished result is cached:
           1. Page: the finished Markdown per site, database, language, item, version, device and host,
              in memory on each server. Hits are served in httpRequestBegin (ServeCachedMarkdown) before
              any layout or rendering runs; concurrent misses for one page build it once.
              Logged-in users are never cached. Cleared on publish (publish:end and publish:end:remote).
           2. HTTP: cached responses carry ETag and Last-Modified (304 Not Modified on revalidation) and,
              for anonymous visitors, Cache-Control: public, max-age so CDNs and agents can keep them.
           Markdown requests never read or write Sitecore's rendering (HTML) cache, so HTML pages and
           custom GenerateCacheKey processors are unaffected. -->
      <!-- Minutes to keep generated Markdown in memory (0 = off). -->
      <setting name="MarkdownForAI.CacheMinutes" value="30" />
      <!-- Memory limit for the Markdown and llms.txt cache, in MB. -->
      <setting name="MarkdownForAI.CacheSizeMB" value="100" />
      <!-- false = query strings are ignored by the cache (?utm_source=... cannot fill it). Set true only if
           components change their output based on the query string. -->
      <setting name="MarkdownForAI.CacheVaryByQueryString" value="false" />
      <!-- Databases whose content is never cached, in memory or by browsers and CDNs, pipe separated. Sites
           served from master (local development, preview) change on save, and only a publish would clear
           the cache. Content delivery servers read web and are cached as usual. -->
      <setting name="MarkdownForAI.NoCacheDatabases" value="master" />
      <!-- max-age sent to CDNs, proxies and agents for cached Markdown and llms.txt (0 = always revalidate).
           Keep it short: a CDN keeps serving its copy for this long after a publish. -->
      <setting name="MarkdownForAI.HttpCacheMinutes" value="10" />

      <!-- ===== Response ===== -->
      <!-- Sends X-Robots-Tag: noindex so search engines index the HTML page, not the .md copy. -->
      <setting name="MarkdownForAI.NoIndexHeader" value="true" />
      <!-- HTML pages send Link: <https://host/page.md>; rel="alternate"; type="text/markdown", so agents find
           the Markdown version from the response headers. Same purpose as @Html.MarkdownAlternateLink(). -->
      <setting name="MarkdownForAI.LinkHeader" value="true" />
      <!-- Force the scheme of generated URLs (e.g. "https" behind an SSL offloader). Empty = request scheme or X-Forwarded-Proto. -->
      <setting name="MarkdownForAI.Scheme" value="" />

      <!-- ===== llms.txt =====
           Lists pages that inherit the _LlmsPage template and have "LlmsInclude" checked.
           The site start item's LlmsTitle / LlmsSummary become the llms.txt header. -->
      <setting name="MarkdownForAI.LlmsTxt.Enabled" value="true" />
      <setting name="MarkdownForAI.LlmsTxt.FullEnabled" value="true" />
      <!-- tree = walk the content tree (simple, fine up to a few thousand items); index = ContentSearch query. -->
      <setting name="MarkdownForAI.LlmsTxt.Source" value="tree" />
      <!-- Index for Source=index. Empty = sitecore_{database}_index. -->
      <setting name="MarkdownForAI.LlmsTxt.IndexName" value="" />
      <setting name="MarkdownForAI.LlmsTxt.MaxItems" value="5000" />
      <setting name="MarkdownForAI.LlmsTxt.FullMaxChars" value="5000000" />
      <!-- Minutes to keep llms.txt and llms-full.txt in memory (0 = off). Cleared on publish. -->
      <setting name="MarkdownForAI.LlmsTxt.CacheMinutes" value="60" />

      <!-- ===== Ask AI button =====
           Button text, prompt and the AI assistants (ChatGPT, Claude, Perplexity, ...) are Sitecore items under
           /sitecore/system/Modules/Markdown For AI/Ask AI. Add the "Ask AI" rendering to a page, or call
           @Html.AskAi() in a view. -->
      <!-- Where ask-ai.js is served from (html-to-markdown.js must be next to it). Empty = load it yourself. -->
      <setting name="MarkdownForAI.AskAi.ScriptUrl" value="/scripts/markdownforai/ask-ai.js" />
    </settings>

    <pipelines>
      <!-- Must run before FilterUrlExtensions, which would otherwise ignore .md and .txt requests. -->
      <preprocessRequest role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.Pipelines.DetectMarkdownRequest, Sitecore.MarkdownForAI"
                   patch:before="processor[@type='Sitecore.Pipelines.PreprocessRequest.FilterUrlExtensions, Sitecore.Kernel']" />
      </preprocessRequest>

      <httpRequestBegin role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.Pipelines.ValidateMarkdownRequest, Sitecore.MarkdownForAI"
                   patch:before="processor[@type='Sitecore.Pipelines.HttpRequest.ItemResolver, Sitecore.Kernel']" />
        <!-- Before LayoutResolver, so custom item resolvers have already run. -->
        <processor type="Sitecore.MarkdownForAI.Pipelines.ServeCachedMarkdown, Sitecore.MarkdownForAI"
                   patch:before="processor[@type='Sitecore.Pipelines.HttpRequest.LayoutResolver, Sitecore.Kernel']" />
        <!-- After LayoutResolver: MVC pages continue to the MVC pipeline, WebForms pages to the WebForms
             processors below (or a field mapping answers here); other layout types get 404 for /page.md. -->
        <processor type="Sitecore.MarkdownForAI.Pipelines.CheckMarkdownLayout, Sitecore.MarkdownForAI"
                   patch:after="processor[@type='Sitecore.Pipelines.HttpRequest.LayoutResolver, Sitecore.Kernel']" />
        <!-- HTML pages: Link header pointing to the Markdown version (MarkdownForAI.LinkHeader). -->
        <processor type="Sitecore.MarkdownForAI.Pipelines.AddMarkdownLinkHeader, Sitecore.MarkdownForAI"
                   patch:after="processor[@type='Sitecore.Pipelines.HttpRequest.LayoutResolver, Sitecore.Kernel']" />
      </httpRequestBegin>

      <!-- WebForms: drop excluded renderings and sublayouts (after personalization), then convert the page. -->
      <insertRenderings role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.WebForms.FilterMarkdownRenderings, Sitecore.MarkdownForAI" />
      </insertRenderings>

      <renderLayout role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.WebForms.PrepareMarkdownPage, Sitecore.MarkdownForAI" />
      </renderLayout>

      <mvc.getPageRendering role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.Pipelines.UseMarkdownPageRenderer, Sitecore.MarkdownForAI"
                   patch:after="processor[@type='Sitecore.Mvc.Pipelines.Response.GetPageRendering.GetLayoutRendering, Sitecore.Mvc']" />
      </mvc.getPageRendering>

      <mvc.renderRendering role:require="Standalone or ContentDelivery">
        <!-- First processor: drops excluded renderings and keeps Markdown requests out of the rendering (HTML)
             cache. Positioned by index, so it works with solutions that replace SetCacheability or GenerateCacheKey. -->
        <processor type="Sitecore.MarkdownForAI.Pipelines.ApplyMarkdownMode, Sitecore.MarkdownForAI"
                   patch:before="processor[1]" />
      </mvc.renderRendering>

      <initialize role:require="Standalone or ContentDelivery">
        <processor type="Sitecore.MarkdownForAI.Pipelines.RegisterMarkdownViewEngine, Sitecore.MarkdownForAI" />
      </initialize>
    </pipelines>

    <events role:require="Standalone or ContentDelivery">
      <event name="publish:end">
        <handler type="Sitecore.MarkdownForAI.Caching.ClearMarkdownCache, Sitecore.MarkdownForAI" method="OnPublishEnd" />
      </event>
      <event name="publish:end:remote">
        <handler type="Sitecore.MarkdownForAI.Caching.ClearMarkdownCache, Sitecore.MarkdownForAI" method="OnPublishEnd" />
      </event>
    </events>

    <markdownForAI>
      <!-- Sources build Markdown from item fields without rendering the page. They are tried in
           order; when none returns a document, the page's renderings are converted instead.
           Add your own by implementing Sitecore.MarkdownForAI.Sources.IMarkdownSource. -->
      <sourceList type="Sitecore.MarkdownForAI.Sources.MarkdownSourceList, Sitecore.MarkdownForAI" singleInstance="true">
        <sources hint="list:AddSource">
          <fieldMapping type="Sitecore.MarkdownForAI.Sources.FieldMappingSource, Sitecore.MarkdownForAI">
            <mappings hint="raw:AddMapping">
              <!--
                One mapping per template. Pipe-separated field names. "inherited" (default true) also
                matches templates that inherit from this one. "meta" fields go into the front matter;
                reference fields become display names, dates become yyyy-MM-dd.
              <mapping template="{00000000-0000-0000-0000-000000000000}" title="Title" summary="Summary"
                       body="Body" meta="Author|Published Date|Topics" />
              -->
            </mappings>
          </fieldMapping>
        </sources>
      </sourceList>
    </markdownForAI>
  </sitecore>
</configuration>
